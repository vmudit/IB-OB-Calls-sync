# HubSpot private app token with contact read and contact write. Never commit a real value.
HUBSPOT_TOKEN=

# GCP project that runs the BigQuery job. Datasets in sql/calls.sql must be in this project,
# or the query must use project.dataset.table names.
BQ_PROJECT_ID=

# Full service-account JSON object (one value, not a file path). Never commit a real value.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional. Example: US or EU. Leave empty to use the client default.
BQ_LOCATION=

# Optional contact property internal names. Leave empty to use ib_15 and ob_15.
HUBSPOT_IB_PROPERTY=
HUBSPOT_OB_PROPERTY=

# Leave empty for a dry run. Set to yes-really-run-live only when HubSpot writes should happen.
CONFIRM_LIVE_RUN=
